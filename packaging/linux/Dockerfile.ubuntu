# Сборка на старой поддерживаемой glibc, а не на системе разработчика.
FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates binutils patchelf xvfb xauth libegl1 libgl1 libopengl0 \
    libfontconfig1 libdbus-1-3 libxcb-cursor0 libxcb-icccm4 libxcb-image0 \
    libxcb-keysyms1 libxcb-render-util0 libxcb-shape0 libxcb-xinerama0 \
    libxcb-xkb1 libxkbcommon-x11-0 libglib2.0-bin desktop-file-utils \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace/cyberlab
